{
  "name": "ticbuild-vs-code",
  "description": "ticbuild extension for VS Code - control surface and syntax highlighting for TIC-80 development & debugging",
  "displayName": "TIC-80 ticbuild development & debugging control surface",
  "version": "0.0.6",
  "main": "./out/extension.js",
  "author": {
    "name": "Carl Corcoran"
  },
  "publisher": "TridentLoop",
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:tic80ControlSurfacePanel",
    "onLanguage:lua"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/thenfour/ticbuild_vscode"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "TIC-80",
    "TIC80",
    "ticbuild",
    "debugger",
    "control surface",
    "fantasy console",
    "Lua",
    "watch",
    "monitor",
    "remoting",
    "TIC"
  ],
  "files": [
    "package.json",
    "README.md",
    "LICENSE",
    "syntaxes/**",
    "out/**",
    ".attachments/**",
    "ControlSurfaceUI/dist/**",
    "resources/**"
  ],
  "scripts": {
    "typecheck": "tsc -p ./ --noEmit",
    "test:grammar": "node ./scripts/test-grammar.js",
    "compile": "npm run typecheck && node ./esbuild.js",
    "watch": "node ./esbuild.js --watch",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.20.2",
    "typescript": "^5.3.3",
    "vscode": "^1.1.37",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "contributes": {
    "configuration": {
      "title": "TIC-80 ticbuild",
      "properties": {
        "tic80.controlSurface.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "order": 1,
          "description": "Enable the TIC-80 control surface, remoting, watches, discovery, and related commands."
        },
        "tic80.language.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "order": 2,
          "description": "Enable ticbuild-aware Lua language features. Syntax highlighting is contributed separately and is not affected."
        },
        "tic80.remote.host": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Default TIC-80 remoting host."
        },
        "tic80.remote.port": {
          "type": "number",
          "default": 9977,
          "description": "Default TIC-80 remoting port."
        },
        "tic80.remote.autoConnect": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Automatically connect to TIC-80 sessions announced in the current workspace."
        },
        "tic80.remote.discovery.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Discover local TIC-80 instances for the attach picker and control surface."
        },
        "tic80.remote.showStatusBar": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Show TIC-80 remoting connection status in the status bar."
        },
        "tic80.devtools.autoConfigureSchema": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Create devtools.schema.json and add its $schema reference to an existing .ticbuild/devtools.json file."
        },
        "tic80.pollHz": {
          "type": "number",
          "default": 10,
          "description": "Polling rate (Hz) for watch updates."
        },
        "tic80.uiRefreshMs": {
          "type": "number",
          "default": 217,
          "description": "UI refresh interval (ms) for TIC-80 watch tree updates."
        },
        "tic80.discoveryRefreshMs": {
          "type": "number",
          "default": 2500,
          "description": "Polling interval (ms) for refreshing discovered TIC-80 instances. Set to 0 to disable polling."
        },
        "tic80.connectTimeoutMs": {
          "type": "number",
          "default": 3000,
          "description": "Timeout in milliseconds for connecting to TIC-80 remoting."
        },
        "tic80.language.signatureHelp": {
          "type": "boolean",
          "default": true,
          "description": "Enable TIC-80 signature help for Lua."
        },
        "tic80.language.completion": {
          "type": "boolean",
          "default": true,
          "description": "Enable TIC-80 completion items for Lua."
        },
        "tic80.language.hover": {
          "type": "boolean",
          "default": true,
          "description": "Enable TIC-80 hover help for Lua."
        },
        "tic80.language.definition": {
          "type": "boolean",
          "default": true,
          "description": "Enable TIC-80 definition/declaration for Lua."
        },
        "tic80.language.documentSymbols": {
          "type": "boolean",
          "default": true,
          "description": "Enable TIC-80 document symbols for Lua."
        }
      }
    },
    "commands": [
      {
        "command": "tic80.attach",
        "title": "TIC-80: Attach...",
        "enablement": "config.tic80.controlSurface.enabled"
      },
      {
        "command": "tic80.reloadDevtools",
        "title": "TIC-80: Reload Devtools Config",
        "enablement": "config.tic80.controlSurface.enabled"
      },
      {
        "command": "tic80.addPanel",
        "title": "TIC-80: Add Panel",
        "enablement": "config.tic80.controlSurface.enabled"
      },
      {
        "command": "tic80.removePanel",
        "title": "TIC-80: Remove Panel",
        "enablement": "config.tic80.controlSurface.enabled"
      },
      {
        "command": "tic80.detach",
        "title": "TIC-80: Detach",
        "enablement": "config.tic80.controlSurface.enabled"
      }
    ],
    "grammars": [
      {
        "scopeName": "source.ticbuild.preproc.injection",
        "path": "./syntaxes/ticbuild-preproc.tmLanguage.json",
        "injectTo": [
          "source.lua",
          "source.lua.embedded",
          "meta.embedded.block.lua",
          "text.html.markdown"
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tic80",
          "title": "TIC-80",
          "icon": "resources/desktop-classic.svg"
        }
      ]
    },
    "views": {
      "tic80": [
        {
          "id": "tic80ControlSurfaceActivity",
          "name": "Control Surface",
          "type": "webview",
          "icon": "resources/desktop-classic.svg",
          "when": "config.tic80.controlSurface.enabled"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "tic80.attach",
          "when": "config.tic80.controlSurface.enabled"
        },
        {
          "command": "tic80.reloadDevtools",
          "when": "config.tic80.controlSurface.enabled"
        },
        {
          "command": "tic80.addPanel",
          "when": "config.tic80.controlSurface.enabled"
        },
        {
          "command": "tic80.removePanel",
          "when": "config.tic80.controlSurface.enabled"
        },
        {
          "command": "tic80.detach",
          "when": "config.tic80.controlSurface.enabled"
        }
      ]
    }
  }
}
